@page "/admin/products/create"
@layout AdminLayout
@using ShopAccessories.Models
@using ShopAccessories.Services
@inject AdminStateService AdminState
@inject NavigationManager NavigationManager

<PageTitle>Thêm sản phẩm</PageTitle>

<div class="admin-product-form">
    <h1>Thêm sản phẩm mới</h1>
    <EditForm Model="@product" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label for="name">Tên sản phẩm:</label>
            <input id="name" @bind="product.Name" class="form-input" />
            <ValidationMessage For="@(() => product.Name)" />
        </div>

        <div class="form-group">
            <label for="category">Danh mục:</label>
            <select id="category" @bind="product.Category" class="form-input">
                <option value="Ví">Ví</option>
                <option value="Túi xách">Túi xách</option>
                <option value="Balo">Balo</option>
                <option value="Thắt lưng">Thắt lưng</option>
                <option value="Mũ">Mũ</option>
            </select>
            <ValidationMessage For="@(() => product.Category)" />
        </div>

        <div class="form-group">
            <label for="price">Giá (đ):</label>
            <input id="price" type="number" @bind="product.Price" class="form-input" />
            <ValidationMessage For="@(() => product.Price)" />
        </div>

        <div class="form-group">
            <label for="oldPrice">Giá cũ (đ) (optional):</label>
            <input id="oldPrice" type="number" @bind="product.OldPrice" class="form-input" />
        </div>

        <div class="form-group">
            <label for="imageUrl">URL ảnh:</label>
            <input id="imageUrl" @bind="product.ImageUrl" class="form-input" placeholder="https://images.unsplash.com/..." />
            <ValidationMessage For="@(() => product.ImageUrl)" />
        </div>

        <div class="form-group">
            <label for="description">Mô tả:</label>
            <textarea id="description" @bind="product.Description" class="form-textarea" rows="4"></textarea>
            <ValidationMessage For="@(() => product.Description)" />
        </div>

        <div class="form-group">
            <label for="material">Chất liệu:</label>
            <input id="material" @bind="product.Material" class="form-input" />
            <ValidationMessage For="@(() => product.Material)" />
        </div>

        <div class="form-group">
            <label for="rating">Đánh giá (0-5):</label>
            <input id="rating" type="number" min="0" max="5" @bind="product.Rating" class="form-input" />
            <ValidationMessage For="@(() => product.Rating)" />
        </div>

        <div class="form-group">
            <label for="stock">Tồn kho:</label>
            <input id="stock" type="number" min="0" @bind="product.Stock" class="form-input" />
            <ValidationMessage For="@(() => product.Stock)" />
        </div>

        <div class="form-group">
            <button type="submit" class="btn btn-primary">Thêm sản phẩm</button>
            <a href="/admin/products" class="btn btn-outline">Hủy</a>
        </div>
    </EditForm>
</div>

@code {
    private Product product = new Product();

    private void HandleValidSubmit()
    {
        AdminState.AddProduct(product);
        NavigationManager.NavigateTo("/admin/products");
    }
}