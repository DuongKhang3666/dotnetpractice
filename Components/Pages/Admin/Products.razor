@page "/admin/products"
@layout AdminLayout
@using ShopAccessories.Models
@using ShopAccessories.Services
@using System.Globalization
@inject AdminStateService AdminState
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Quản lý sản phẩm</PageTitle>

<div class="admin-products-page">
    <div class="page-header">
        <h1>Quản lý sản phẩm</h1>
        <a href="/admin/products/create" class="btn btn-primary">Thêm sản phẩm</a>
    </div>

    <div class="filters">
        <div class="search-box">
            <input type="text" @bind="SearchTerm" @bind:event="oninput" placeholder="Tìm kiếm theo tên..." />
        </div>
        <div class="category-filters">
            <span>Danh mục:</span>
            <a href="/admin/products" class="@(SelectedCategory == null ? "active" : "")">Tất cả</a>
            @foreach (var category in Categories)
            {
                <a href="@($"/admin/products/{category}")" class="@(SelectedCategory == category ? "active" : "")">@category</a>
            }
        </div>
    </div>

    <div class="product-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th>Danh mục</th>
                    <th>Giá</th>
                    <th>Tồn kho</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in FilteredProducts)
                {
                    <tr>
                        <td><img src="@product.ImageUrl" alt="@product.Name" class="product-image-small" /></td>
                        <td>@product.Name</td>
                        <td>@product.Category</td>
                        <td>@product.Price.ToString("N0", new CultureInfo("vi-VN")) ₫</td>
                        <td>
                            <span class="product-stock @GetStockClass(product.Stock)">@GetStockText(product.Stock)</span>
                        </td>
                        <td>
                            <a href="/admin/products/edit/@product.Id" class="btn btn-outline btn-sm me-1">Sửa</a>
                            <button class="btn btn-outline btn-sm" @onclick="async () => await DeleteProduct(product.Id)">Xóa</button>
                        </td>
                    </tr>
                }
                @if (!FilteredProducts.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center">Không có sản phẩm nào phù hợp với bộ lọc.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private string SearchTerm = string.Empty;
    private string? SelectedCategory;

    private IEnumerable<Product> FilteredProducts =>
        ApplyFilters(AdminState.Products);

    private IEnumerable<Product> ApplyFilters(IEnumerable<Product> products)
    {
        var filtered = products;

        if (!string.IsNullOrWhiteSpace(SearchTerm))
        {
            filtered = filtered.Where(p =>
                p.Name.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(SelectedCategory))
        {
            filtered = filtered.Where(p => p.Category == SelectedCategory);
        }

        return filtered;
    }

    private IEnumerable<string> Categories => AdminState.Products
        .Select(p => p.Category)
        .Distinct()
        .OrderBy(c => c);

    private string GetStockClass(int stock)
    {
        if (stock == 0) return "out-of-stock";
        if (stock < 5) return "low-stock";
        return "in-stock";
    }

    private string GetStockText(int stock)
    {
        if (stock == 0) return "Hết hàng";
        if (stock < 5) return "Sắp hết hàng";
        return "Còn hàng";
    }

    private async Task DeleteProduct(int id)
    {
        bool confirmDelete = await JS.InvokeAsync<bool>("confirm", "Bạn có chắc chắn muốn xóa sản phẩm này?");
        if (confirmDelete)
        {
            AdminState.DeleteProduct(id);
            NavigationManager.NavigateTo("/admin/products", true);
        }
    }

    protected override void OnParametersSet()
    {
        // If category is provided in the route, set it as selected
        if (NavigationManager.Uri.Contains("/admin/products/"))
        {
            var segments = NavigationManager.Uri.Split('/');
            if (segments.Length > 4 && !string.IsNullOrEmpty(segments[4]))
            {
                SelectedCategory = Uri.UnescapeDataString(segments[4]);
            }
        }
        else
        {
            SelectedCategory = null;
        }
    }
}